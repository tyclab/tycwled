+#ifdef UM_AUDIOREACTIVE_PDM_ENVELOPE_PERIOD_US
+    void updatePdmEnvelope()
+    {
+      constexpr uint32_t periodUs = UM_AUDIOREACTIVE_PDM_ENVELOPE_PERIOD_US;
+      constexpr uint32_t blockUs = uint32_t(samplesFFT * 1000000UL / SAMPLE_RATE);
+      static_assert(periodUs > 0 && periodUs <= blockUs, "Invalid PDM envelope sample period");
+      const int64_t nowUs = esp_timer_get_time();
+      static int64_t previousUs = nowUs - periodUs;
+
+      // Only the latest FFT block's peak is available after a stall.
+      if (nowUs - previousUs > blockUs) previousUs = nowUs - periodUs;
+      while (nowUs - previousUs >= periodUs) {
+        previousUs += periodUs;
+        getSample();
+        agcAvg(static_cast<uint32_t>(previousUs / 1000), true);
+      }
+    }
