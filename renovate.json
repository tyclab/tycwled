{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "labels": ["dependencies"],
  "timezone": "Europe/Berlin",
  "minimumReleaseAge": "3 days",
  "prHourlyLimit": 2,
  "prConcurrentLimit": 3,
  "pre-commit": {
    "description": "Off by default in Renovate; bumps the hook `rev:` pins in .pre-commit-config.yaml.",
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "The pinned gitleaks release the CI history scan downloads",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yml$/"],
      "matchStrings": ["gitleaks/releases/download/v(?<currentValue>[0-9.]+)/"],
      "depNameTemplate": "gitleaks/gitleaks",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "The WLED release tag fleet/build.sh asserts before building the fleet firmware, and the checkout commands and paths that name it in build.sh and the READMEs: one MR moves every site.",
      "managerFilePatterns": [
        "/^fleet/build\\.sh$/",
        "/^README\\.md$/",
        "/^fleet/README\\.md$/",
        "/^glorb/usermod/glorb_fx/README\\.md$/"
      ],
      "matchStrings": [
        "\\[ \"\\$tag\" = (?<currentValue>v\\d+\\.\\d+\\.\\d+) \\]",
        "expected (?<currentValue>v\\d+\\.\\d+\\.\\d+)\"",
        "<WLED checkout at (?<currentValue>v\\d+\\.\\d+\\.\\d+)>",
        "<WLED (?<currentValue>v\\d+\\.\\d+\\.\\d+) checkout>",
        "--branch (?<currentValue>v\\d+\\.\\d+\\.\\d+) https://github\\.com/wled/WLED\\.git",
        "\\.\\./WLED-(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "wled/WLED",
      "datasourceTemplate": "github-tags"
    }
  ],
  "packageRules": [
    {
      "description": "A WLED bump changes the firmware flashed to the lamps and the effect ids the fleet configs were checked against (glorb_fx), so it is reviewed and re-verified, never automerged.",
      "matchDepNames": ["wled/WLED"],
      "automerge": false
    }
  ]
}
